# The GPT Action sends this value in X-Plant-API-Key.
PLANT_API_KEY=replace-with-a-long-random-value

# Keep false until dry-run tests with the private GPT are complete.
PLANT_API_WRITE_ENABLED=false

# Public HTTPS origin of this service, without a trailing slash.
PLANT_API_PUBLIC_URL=https://plant-api.example.com

# Separate token limited to data.records:read + data.records:write for this base.
AIRTABLE_WRITE_TOKEN=pat_replace_me
AIRTABLE_BASE_ID=appnyj7AhSHhW4PUe

# Service-account static key limited to the plant-diary-photos bucket.
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
S3_BUCKET=plant-diary-photos
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1

# Optional: immediately dispatch the existing Pages workflow after a successful write.
PLANT_GITHUB_TOKEN=replace_me
GITHUB_REPOSITORY=KruchDmitriy/plant-diary-site
GITHUB_WORKFLOW=deploy-pages.yml
