{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PlantDiaryPublicWeb",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::plant-diary-photos/web/*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    }
  ]
}